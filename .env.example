# Copy this file to .env for local development (Vite loads .env automatically).
# All variables here are PUBLIC — they are bundled into the client and are
# visible to anyone who opens the app. Never put a secret/service-role key
# in a VITE_-prefixed variable. Row Level Security in Postgres is what
# actually protects your data, not keeping these values hidden.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
# Find it in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=

# Supabase anon/public API key (safe for client-side use; RLS enforces access).
# Find it in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# The URL this app is deployed at (used as the magic-link redirect target).
# Local dev: http://127.0.0.1:5173
# Production: your Cloudflare Pages URL, e.g. https://iceland-trip.pages.dev
VITE_APP_URL=http://127.0.0.1:5173
